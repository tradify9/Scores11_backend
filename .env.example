# Backend Environment Variables - Copy to .env and fill values
# Get Gmail App Password: https://support.google.com/mail/answer/185833

NODE_ENV=development
PORT=3000

# JWT (generate strong secrets)
JWT_SECRET=your-super-secret-jwt-key-here-at-least-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-here-at-least-32-chars

# MongoDB
MONGODB_URI=mongodb://localhost:27017/crick11

# Redis (optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Cloudinary (for images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=

# EMAIL - Gmail SMTP (Recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-email@gmail.com
SMTP_PASS=your-16-char-app-password-here
EMAIL_FROM="Crick11 <your-sending-email@gmail.com>"

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
