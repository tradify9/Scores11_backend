NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-chars
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_REFRESH_EXPIRE=90d

# MongoDB
MONGODB_URI=mongodb://localhost:27017/crick11
MONGODB_URI_PROD=your-production-mongodb-uri

# Seed/admin bootstrap credentials
ADMIN_SEED_EMAIL=admin@crick11.com
ADMIN_SEED_PASSWORD=admin123
ADMIN_SEED_USERNAME=sumitbawa95
ADMIN_SEED_NAME=Sumit Kumari
ADMIN_SEED_PHONE=+919999999999
SEED_USER_EMAIL=seed@crick11.com
SEED_USER_PASSWORD=password123
SEED_USER_PHONE=+919999999998

# Redis (optional, for caching/sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin (notifications and phone ID-token verification)
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_PROJECT_ID=scores11-9a227
FIREBASE_AUTH_PROJECT_IDS=scores11-9a227
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Scores11" <noreply@scores11.com>

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Tournament Settings
TOURNAMENT_AUTO_CLOSE_DAYS=7
MATCH_REMINDER_HOURS=24

# Wallet
WALLET_MIN_DEPOSIT=10
WALLET_MAX_DEPOSIT=10000
WALLET_MIN_WITHDRAWAL=100

# ZenStream live streaming
ZENSTREAM_API_KEY=your_zenstream_api_key_here
ZENSTREAM_BASE_URL=https://api.zenstream.live/v1
ZENSTREAM_RTMP_SERVER=rtmp://live-ingest-01.vd0.co:1935/livestream
ZENSTREAM_PLAYER_URL=https://player.zenstream.live
ZENSTREAM_HLS_URL=

# YouTube Live
# Without these, users can still go live by pasting a YouTube live link.
# With them, users can also "Connect channel" and the app creates the broadcast.
# Google Cloud: enable "YouTube Data API v3", create an OAuth client of type
# "Web application" with exactly this redirect URI.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://scores11.com/api/v1/live-streams/youtube/callback
YOUTUBE_API_KEY=
YOUTUBE_API_SCOPE=https://www.googleapis.com/auth/youtube

# Help & Support screen in the app (shown only when set)
SUPPORT_EMAIL=support@scores11.com
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
SUPPORT_WEBSITE=https://scores11.com

# Database name (optional, defaults to crick11)
MONGODB_DB_NAME=crick11
