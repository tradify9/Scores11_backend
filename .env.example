# Zenstream Configuration
ZENSTREAM_API_KEY=your_zenstream_api_key_here
ZENSTREAM_BASE_URL=https://api.zenstream.live/v1
ZENSTREAM_RTMP_SERVER=rtmp://live-ingest-01.vd0.co:1935/livestream
ZENSTREAM_PLAYER_URL=https://player.zenstream.live
ZENSTREAM_HLS_URL=

# YouTube Live Configuration
# API key is useful for public video/status checks.
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# OAuth client is required if the backend should create/start YouTube live broadcasts.
YOUTUBE_CLIENT_ID=your_google_oauth_web_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_oauth_web_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/live-streams/youtube/callback
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_web_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/live-streams/youtube/callback
YOUTUBE_API_SCOPE=https://www.googleapis.com/auth/youtube

# Backend
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/crick11
JWT_SECRET=your_jwt_secret

