NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-chars
JWT_EXPIRE=30d
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_REFRESH_EXPIRE=90d

# MongoDB
MONGODB_URI=mongodb://localhost:27017/crick11
MONGODB_URI_PROD=your-production-mongodb-uri

# Redis (optional, for caching/sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin (notifications and phone ID-token verification)
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_PROJECT_ID=scores11-9a227
FIREBASE_AUTH_PROJECT_IDS=scores11-9a227
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_URL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Crick11" <noreply@crick11.app>

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Tournament Settings
TOURNAMENT_AUTO_CLOSE_DAYS=7
MATCH_REMINDER_HOURS=24

# Wallet
WALLET_MIN_DEPOSIT=10
WALLET_MAX_DEPOSIT=10000
WALLET_MIN_WITHDRAWAL=100

# ZenStream live streaming
ZENSTREAM_API_KEY=your_zenstream_api_key_here
ZENSTREAM_BASE_URL=https://api.zenstream.live/v1
ZENSTREAM_RTMP_SERVER=rtmp://live-ingest-01.vd0.co:1935/livestream
ZENSTREAM_PLAYER_URL=https://player.zenstream.live
ZENSTREAM_HLS_URL=

# YouTube Live
YOUTUBE_API_KEY=your_youtube_data_api_key_here
YOUTUBE_CLIENT_ID=your_google_oauth_web_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_oauth_web_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/live-streams/youtube/callback
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_web_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/live-streams/youtube/callback
YOUTUBE_API_SCOPE=https://www.googleapis.com/auth/youtube
